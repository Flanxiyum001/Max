# Sample NAMES only. Generate a new high-entropy token locally, never commit its value.
# PowerShell: $env:MAX_API_BEARER_TOKEN = python -c "import secrets; print(secrets.token_urlsafe(48))"
# Linux: export MAX_API_BEARER_TOKEN="$(python -c 'import secrets; print(secrets.token_urlsafe(48))')"
MAX_BIND_HOST=127.0.0.1
MAX_BIND_PORT=8765
MAX_LOG_LEVEL=INFO

# Optional PostgreSQL after you create a local DB and run Alembic migrations.
# Set a private URL in your terminal; never commit a real password or connection string.
# MAX_DATABASE_URL=postgresql+psycopg://local_user@127.0.0.1:5432/max_core

# Optional local desktop overrides (defaults to SQLite under your user AppData/XDG data dir).
# MAX_DESKTOP_DB_URL=
# MAX_LOCAL_DB_PATH=
# MAX_CONFIG_PATH=
# MAX_WORKSPACE_ROOT=
# MAX_NOTES_DIR=

# Cloud LLM provider selection ("openai", "anthropic", or "auto").
# Copy this file to .env locally and add your own key; never commit real API keys.
# MAX_LLM_PROVIDER=openai

# OpenAI provider settings
# OPENAI_API_KEY=
# MAX_OPENAI_MODEL=gpt-4o-mini
# MAX_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# MAX_OPENAI_INPUT_USD_PER_MILLION=0.15
# MAX_OPENAI_OUTPUT_USD_PER_MILLION=0.60

# Anthropic provider settings
# ANTHROPIC_API_KEY=
# MAX_ANTHROPIC_MODEL=claude-sonnet-4-5
# MAX_ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
# MAX_ANTHROPIC_INPUT_USD_PER_MILLION=3.00
# MAX_ANTHROPIC_OUTPUT_USD_PER_MILLION=15.00

# Per-turn cloud egress budget cap (USD)
# MAX_COST_USD=0.05

# Voice settings
# MAX_VOICE_LOCALE=en-GB
# MAX_VOICE_PRESENTATION=feminine
# MAX_TTS_ENABLED=false

# MAX assistant (python -m max_core.chat and the orb) — see docs/M28_ASSISTANT_TOOLKIT.md
# MAX_TRIAL_DESTINATION=cloud
# MAX_TRIAL_CLOUD_ALLOWED=yes
# MAX_TRIAL_ENDPOINT=https://<provider>/v1/chat/completions
# MAX_TRIAL_MODEL=
# MAX_TRIAL_API_KEY=
# MAX_TRIAL_CONTEXT_TOKENS=8192
# MAX_TRIAL_MAX_COST_USD=0
# MAX_TRIAL_INPUT_USD_PER_MILLION=0
# MAX_TRIAL_OUTPUT_USD_PER_MILLION=0
# MAX_CLOUD_PERSONAL_TOOLS=no
# MAX_ENABLE_SHELL=no
# Windows only, local models only: let MAX type, press keys, click, scroll, open
# apps/sites and switch windows without asking. Mouse in the top-left corner = stop.
# MAX_PC_CONTROL=full
# MAX_ENABLE_WEB=yes
# MAX_DATA_DIR=

# Optional HTTPS MCP token: set in your OS process environment, not here.
# The desktop System tab lets you supply ONLY the environment-variable name.
# Example: MAX_MCP_GITHUB_TOKEN is supplied privately before launching MAX.
# MAX_MCP_CONFIG_PATH=  # optional profile location (never a credential)

# Talking to MAX (orb: press Space) — see docs/M29_ORB_VOICE.md
# MAX_STT_ENDPOINT=https://<provider>/v1/audio/transcriptions
# MAX_STT_MODEL=
# MAX_STT_API_KEY=
# Optional spelling hints (sent to the configured speech provider):
# MAX_STT_VOCAB=MAX, Aventas, Ryoko, GitHub, Cloudflare, pull request
# Leave language unset for automatic detection / mixed-language speech.
# MAX_STT_LANGUAGE=en
# Raw preserves quiet consonants and pauses; filtered keeps the legacy noise gate.
# MAX_STT_AUDIO_MODE=raw
# Optional web-only literal transcript mode (may surface noise hallucinations):
# MAX_STT_VERBATIM=yes
# MAX_VOICE_ALWAYS_ALLOW_REMOTE_STT=no

# Optional Magnitude model ID from start-max.cmd --check-magnitude.
# Launch with start-max.cmd --magnitude; normal launch and Ollama stay unchanged.
# MAX_MAGNITUDE_MODEL=
# MAX_MAGNITUDE_CONTEXT_TOKENS=8192
# MAX_MAGNITUDE_TOOLS=no
