# MAX configuration — copy to `.env` and fill in. Never commit real values.
# Values are read from the process environment first; `.env` only fills gaps.

# ---------------------------------------------------------------- providers
# "mock" (default, no network, used by tests/benchmarks) or "openai" for any
# OpenAI-compatible Chat Completions endpoint (FreeLLM, vLLM, Ollama, ...).
MAX_PROVIDER=mock

# OpenAI-compatible base URL. REQUIRED when MAX_PROVIDER=openai.
# Leave empty here until you have verified your FreeLLM endpoint from its docs.
MAX_BASE_URL=

# Model identifier as reported by the provider. REQUIRED when MAX_PROVIDER=openai.
MAX_MODEL=

# Name of the environment variable that holds the API key. The key itself is
# read from the environment only and is never logged, printed or committed.
MAX_API_KEY_ENV=FREELLM_API_KEY
# Optional direct key (prefer MAX_API_KEY_ENV + secret store in production):
# FREELLM_API_KEY=

# Request timeout in seconds, and retries on 429/5xx/connection errors.
MAX_TIMEOUT_S=60
MAX_RETRIES=1

# ------------------------------------------------------------------- agent
MAX_MAX_ITERS=8
# Restrict tools to an explicit allowlist ("a,b,c"). Empty = category policy.
MAX_TOOLS_ALLOW=
MAX_TOOLS_DENY=

# ------------------------------------------------------------------- paths
# All runtime state lives here (sessions, memory, audit log, registry state).
MAX_DATA_DIR=var
# Active Agent-Skills directories (colon separated; relative to repo root).
MAX_SKILLS_DIRS=skills
# Workspace the file tools may read/write (relative to repo root).
MAX_WORKSPACE=workspace

# ------------------------------------------------------------------ skills
MAX_ENABLE_SKILLS=1

# ------------------------------------------------------ self-improvement
# Categories the pipeline may auto-promote when all checks pass.
# Sensitive categories (credentials, authorization, sandbox, network,
# deployment) can NEVER be auto-promoted regardless of this list.
MAX_AUTOPROMOTE=skill,docs
# Human-approval workflow is always required for sensitive categories.

# ------------------------------------------------------ OpenClaw (optional)
# Loopback gateway base URL and token, used only by `max bench --config B`
# and documented integration tests. Leave unset when OpenClaw is not installed.
MAX_OPENCLAW_URL=
MAX_OPENCLAW_TOKEN=

# ------------------------------------------------- Discord bot (Phase 1 text)
# Master switch. The bot does nothing unless this is 1.
MAX_DISCORD_ENABLE=0

# Bot token from the Discord Developer Portal. READ FROM ENV ONLY —
# never commit it, never print it, never put it in a config file.
MAX_DISCORD_TOKEN=

# Explicit channel allowlist (comma-separated channel IDs). No-prefix
# conversation replies happen ONLY in these channels (minus ignored ones).
MAX_DISCORD_ALLOWED_CHANNELS=
# Never reply here, even if listed above (commands are silenced too):
MAX_DISCORD_IGNORED_CHANNELS=
# Optional guild allowlist (comma-separated server IDs). Empty = any server
# that contains an allowlisted channel.
MAX_DISCORD_GUILD_IDS=

# Administrators: user IDs and/or role IDs allowed to run !max allow/deny/channels.
# Checked at the execution layer — never granted by what a message says.
MAX_DISCORD_ADMINS=
MAX_DISCORD_ADMIN_ROLES=

# DM privacy policy: off (default, no DM replies at all) | allowlist (only
# MAX_DISCORD_DM_USERS) | everyone (explicit opt-in, discouraged).
MAX_DISCORD_DM_MODE=off
MAX_DISCORD_DM_USERS=

# Response behaviour in allowlisted channels:
#   all     — reply to every human message (natural conversation)
#   mention — only when @mentioned or replying to MAX
#   command — only !max commands, no conversation
MAX_DISCORD_RESPONSE_MODE=all
MAX_DISCORD_COMMAND_PREFIX=!max

# Rate/robustness limits
MAX_DISCORD_COOLDOWN_S=2
MAX_DISCORD_ERROR_COOLDOWN_S=30
MAX_DISCORD_MAX_MESSAGE_LEN=1900
MAX_DISCORD_HISTORY_LIMIT=12
# Where admin allow/deny changes are persisted (outside .env, gitignored):
MAX_DISCORD_ALLOWLIST_FILE=var/discord/allowlist.json

# ---------------------------------------------------------------------------
# Optional capabilities (Phase: advanced integration). Everything below is
# off or mock by default: MAX starts and chats without any of it.
# ---------------------------------------------------------------------------

# Coding worker — isolated git worktree + allowlisted commands only.
MAX_WORKER_ENABLE=0
# Repos the worker may touch (colon-separated; absolute paths must be inside
# one of these roots). Empty with enable=1 defaults to this repository.
MAX_WORKER_REPOS=
MAX_WORKER_TIMEOUT_S=120
# Network is denied by default even for allowlisted commands.
MAX_WORKER_NETWORK=0

# Repository intelligence (tree-sitter when installed, regex fallback otherwise).
MAX_CODESEARCH_ENABLE=1

# MCP servers — JSON array. Servers are disabled by default and NO tool is
# enabled automatically: list them in tool_allow. Example (single line):
# [{"id":"docs","command":["python","-m","my_server"],"enabled":true,
#   "tool_allow":["search"],"approval_required":["write"],"env_allow":["MY_FLAG"]}]
# Credentials are NEVER passed via env_allow; use a secret store.
MAX_MCP_SERVERS=

# Browser research (optional Playwright MCP server with id "playwright").
# Read-only by default; blocked hosts/private ranges are rejected before launch.
MAX_BROWSER_ENABLE=0
# Host allowlist (comma-separated). Empty = any public host that passes the guard.
MAX_BROWSER_ALLOW_HOSTS=

# Speech-to-text (mock by default; faster-whisper is an optional extra):
#   uv pip install -e '.[stt]'
MAX_STT_BACKEND=mock
MAX_STT_MODEL_SIZE=tiny
MAX_STT_COMPUTE_TYPE=int8
MAX_STT_DEVICE=cpu
MAX_STT_LANGUAGE=
MAX_STT_TIMEOUT_S=30
MAX_STT_MAX_DURATION_S=300
# Model cache directory. local_files_only=1 means nothing is downloaded at startup.
MAX_STT_MODEL_DIR=
MAX_STT_LOCAL_FILES_ONLY=1
