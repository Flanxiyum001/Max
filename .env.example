# Sample NAMES only. Generate a new high-entropy token locally, never commit its value.
# PowerShell: $env:MAX_API_BEARER_TOKEN = python -c "import secrets; print(secrets.token_urlsafe(48))"
# Linux: export MAX_API_BEARER_TOKEN="$(python -c 'import secrets; print(secrets.token_urlsafe(48))')"
MAX_BIND_HOST=127.0.0.1
MAX_BIND_PORT=8765
MAX_LOG_LEVEL=INFO

# Optional PostgreSQL after you create a local DB and run Alembic migrations.
# Set a private URL in your terminal; never commit a real password or connection string.
# MAX_DATABASE_URL=postgresql+psycopg://local_user@127.0.0.1:5432/max_core
